{
  "name": "py8n",
  "version": "1.0.0",
  "private": true,
  "description": "Py8n - Python-native visual workflow automation platform (self-hosted n8n alternative)",
  "scripts": {
    "dev": "nuxt dev --port 3000 2>&1 | tee dev.log",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "echo 'Py8n frontend: lint placeholder'",
    "db:push": "echo 'Py8n: database is managed by the FastAPI backend (SQLAlchemy). Nothing to push.'"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@pinia/nuxt": "^0.9.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.45.0",
    "@vue-flow/minimap": "^1.5.0",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "^3.15.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
