# Py8n edge (Caddy) - the single entrypoint in front of the platform.
#
# THREE concerns live here:
#
# 1. THE PLATFORM - the builder's estate (canvas, systems page, API).
#    Everything lands on the Nuxt frontend; requests carrying the dev
#    transform query (?XTransformPort=<port>) go to that backend port.
#
# 2. TENANT DOMAINS (v104) - a deployed system's custom hostname
#    ("ops.acme.com") must reach ITS front door. Two switches, use
#    either or both:
#      a. the DERIVED route sheet: GET /api/v1/systems/deployment/routes.caddy
#         writes the per-domain site blocks from the live deployments -
#         save it into /etc/caddy/tenants/ and Caddy's glob import below
#         picks it up (a glob matching nothing is not an error, so fresh
#         installs route zero tenants and keep working); or
#      b. the static env list: PY8N_TENANT_HOSTS="ops.acme.com, *.acme.io"
#         (comma-separated site addresses are valid Caddy) - the site
#         block near the bottom maps those hosts onto /go/{host}.
#    DNS for every custom domain points at THIS Caddy either way.
#
# 3. NOTHING ELSE - the default block keeps serving the platform.

# ---------------------------------------------------------------------------
# 1. the platform (unchanged since the XTransformPort contract was set)
#
# Bug fix: every target below used to say `localhost` - correct only when
# Caddy and the services it proxies to share one process/network (the
# single-container sandbox's .zscripts/dev.sh flow). Under docker-compose,
# each service is its own container on the default bridge network, where
# `localhost` inside the caddy container means the caddy container itself
# - nothing listens there, so every proxied request would refuse to
# connect. Compose's default network resolves other services by NAME, so
# the platform frontend is `frontend:3000` and XTransformPort (which the
# frontend only ever sends as the API's port, see stores/auth.ts /
# composables/useApi.ts) resolves against the `api` service.
# ---------------------------------------------------------------------------
:81 {
        @transform_port_query {
                query XTransformPort=*
        }

        handle @transform_port_query {
                reverse_proxy api:{query.XTransformPort} {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle {
                reverse_proxy frontend:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}

# ---------------------------------------------------------------------------
# 2a. tenant domains via the DERIVED route sheet (v104)
#     the sheet is regenerated from the estate (every deployment with a
#     domain becomes `rewrite * /go/{domain}`; dark deployments stay
#     commented out). Mount the directory in docker-compose to use it.
# ---------------------------------------------------------------------------
import /etc/caddy/tenants/*.caddy

# ---------------------------------------------------------------------------
# 2b. tenant domains via the static env list (v104)
#     unset (default), the block's only host is the reserved no-op name
#     and the block is INERT - the sandbox keeps working untouched.
#     set PY8N_TENANT_HOSTS="ops.acme.com, *.acme.io" and those hostnames
#     land on the branded front door: /go/{host} resolves the LIVE
#     deployment's identity before sign-in (v103).
#
#     Bug fix: "INERT" wasn't true before this - Caddy's automatic HTTPS
#     doesn't know the placeholder host is a no-op, so it tried (and
#     retried forever, every startup) to get a real Let's Encrypt
#     certificate for a domain that can never have one. The default now
#     carries an explicit http:// scheme, which is what actually tells
#     Caddy to skip automatic HTTPS for this block - a real operator's
#     PY8N_TENANT_HOSTS value (no scheme prefix) is untouched and still
#     gets full automatic HTTPS as documented.
# ---------------------------------------------------------------------------
{$PY8N_TENANT_HOSTS:http://tenant-routing-disabled.invalid} {
        rewrite * /go/{host}
        reverse_proxy frontend:3000 {
                header_up Host {host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
                header_up X-Real-IP {remote_host}
        }
}
