# ============================================================
# Py8n — strict .gitignore
# Only project source, config and tests belong in the repo.
# ============================================================

# ---------- dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- build artifacts ----------
.nuxt/
.output/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# ---------- secrets & runtime data (NEVER commit) ----------
.env
.env.*
*.pem
*.key
mini-services/api-backend/data/
*.db
*.sqlite
*.sqlite3

# ---------- logs ----------
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- sandbox / platform internals (not part of Py8n) ----------
.zscripts/
.tool-logs/
download/
tool-results/
skills/
.claude
.z-ai-config

# ---------- misc ----------
.DS_Store
.vercel
local-*
test
prompt

# Python bytecode (regenerated at runtime — never project files)
__pycache__/
*.pyc
